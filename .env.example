# ReSlot Environment Variables (.env.example)
# ----------------------------------------------------
# Google Gemini API Key for AI Rescheduling Assistant
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (PostgreSQL 16)
DB_URL=jdbc:postgresql://localhost:5432/reslot
DB_USER=reslot
DB_PASSWORD=reslot

# Security & Admin
JWT_SIGNING_KEY=dev-secret-change-in-production-must-be-256-bits
ADMIN_EMAIL=admin@rscoe.edu.in
ADMIN_INITIAL_PASSWORD=ChangeMe123!
